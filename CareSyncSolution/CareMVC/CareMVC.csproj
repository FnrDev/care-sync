<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Views\Doctor\VisitRecord.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CareSyncAPI\CareSyncAPI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
	</ItemGroup>

	<!--
		The CareSyncAPI project reference is for shared types (ApplicationDbContext,
		models). Because CareSyncAPI is also a Web project, its appsettings*.json flow
		into this project's publish output and collide with our own. Drop the API's
		copies so the MVC's own appsettings are the ones published.

		This must run AFTER ComputeFilesToPublish (so ResolvedFileToPublish is populated)
		but BEFORE _HandleFileConflictsForPublish (the SDK target that raises NETSDK1152
		"Found multiple publish output files with the same relative path"). Both that
		check and this cleanup hook ComputeFilesToPublish, and ordering between same-hook
		targets is otherwise undefined — which is why plain `dotnet publish` worked but
		VS / Web Deploy publishing still failed.
	-->
	<Target Name="RemoveReferencedApiAppSettings"
		AfterTargets="ComputeFilesToPublish"
		BeforeTargets="_HandleFileConflictsForPublish">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
				Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('appsettings'))
					and $([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').Contains('CareSyncAPI'))" />
		</ItemGroup>
	</Target>

</Project>