@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Live Tracking Board";
    var appointments = ViewBag.Appointments as IEnumerable<dynamic>;
    var apiBaseUrl = (Configuration["ApiSettings:BaseUrl"] ?? "").TrimEnd('/');
    var hubUrl = $"{apiBaseUrl}/hubs/appointment";
}

<div class="d-flex align-items-center mb-4">
    <h3 class="mb-0"><i class="bi bi-display me-2"></i>Live Appointment Tracking Board</h3>
    <span class="badge bg-success ms-3">
        <i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i>Live
    </span>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Patient</th>
                        <th>CPR</th>
                        <th>Specialization</th>
                        <th>Time</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="trackingBody">
                    @if (appointments != null && appointments.Any())
                    {
                        @foreach (var a in appointments)
                        {
                            <tr data-id="@a.Id">
                                <td>@a.Id</td>
                                <td>@a.PatientName</td>
                                <td><code>@a.CPR</code></td>
                                <td>@a.Specialization</td>
                                <td>@a.StartTime</td>
                                <td class="status-cell">
                                    <partial name="_StatusBadge" model="@a.StatusName" />
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No appointments today.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("@hubUrl")
            .withAutomaticReconnect()
            .build();

        connection.on("AppointmentStatusChanged", function (data) {
            const row = document.querySelector(`tr[data-id="${data.appointmentId}"]`);
            if (row) {
                const statusCell = row.querySelector(".status-cell");
                statusCell.innerHTML = getBadge(data.newStatus);
                row.style.transition = "background 0.5s";
                row.style.background = "#d1e7dd";
                setTimeout(() => row.style.background = "", 2000);
            }
        });

        function getBadge(status) {
            const colors = {
                "Requested":  "warning text-dark",
                "Confirmed":  "info text-white",
                "CheckedIn":  "primary",
                "InProgress": "warning text-dark",
                "Completed":  "success",
                "Cancelled":  "danger",
                "Missed":     "secondary"
            };
            const cls = colors[status] || "secondary";
            return `<span class="badge bg-${cls}">${status}</span>`;
        }

        async function startConnection() {
            try {
                await connection.start();
                await connection.invoke("JoinClinicBoard");
                console.log("Connected to live board.");
            } catch (err) {
                console.error("SignalR error:", err);
                setTimeout(startConnection, 5000);
            }
        }

        startConnection();
    </script>
}