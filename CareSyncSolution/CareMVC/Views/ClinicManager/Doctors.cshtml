@model List<CareSyncAPI.Models.DoctorProfile>
@{
    ViewData["Title"] = "Doctor Management";
    var users = ViewBag.Users as Dictionary<string, string>;
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Dashboard" class="btn btn-outline-secondary me-3">
        <i class="bi bi-arrow-left"></i> Back
    </a>
    <h3 class="mb-0"><i class="bi bi-person-badge me-2"></i>Doctor Management</h3>
</div>

<partial name="_SuccessErrorAlerts" />

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>License</th>
                        <th>Specializations</th>
                        <th>Consultation (min)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td>
                                <strong>@(users?.GetValueOrDefault(d.UserId, "Unknown"))</strong>
                            </td>
                            <td><code>@d.LicenseNumber</code></td>
                            <td>
                                @foreach (var ds in d.DoctorSpecializations)
                                {
                                    <span class="badge bg-light text-dark border me-1">
                                        @ds.Specialization.Name
                                    </span>
                                }
                            </td>
                            <td>@d.ConsultationDurationMin min</td>
                            <td>
                                <a asp-action="EditDoctor" asp-route-id="@d.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>