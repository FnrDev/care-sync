@{
    ViewData["Title"] = "Clinic Manager Dashboard";
}

<h3 class="mb-1">
    <i class="bi bi-building me-2"></i>Clinic Manager Dashboard
</h3>
<p class="text-muted mb-4">
    <small><i class="bi bi-calendar3 me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</small>
</p>

<partial name="_SuccessErrorAlerts" />

@* Quick Stats *@
<div class="row mb-4 g-3">
    <div class="col-md-3">
        <div class="card border-primary shadow-sm text-center">
            <div class="card-body">
                <h2 class="text-primary">@ViewBag.TotalDoctors</h2>
                <p class="text-muted mb-0"><i class="bi bi-person-badge me-1"></i>Active Doctors</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-success shadow-sm text-center">
            <div class="card-body">
                <h2 class="text-success">@ViewBag.TotalPatients</h2>
                <p class="text-muted mb-0"><i class="bi bi-people me-1"></i>Patients</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-info shadow-sm text-center">
            <div class="card-body">
                <h2 class="text-info">@ViewBag.TodayAppointments</h2>
                <p class="text-muted mb-0"><i class="bi bi-calendar-day me-1"></i>Today's Appointments</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-warning shadow-sm text-center">
            <div class="card-body">
                <h2 class="text-warning">@ViewBag.PendingAppointments</h2>
                <p class="text-muted mb-0"><i class="bi bi-hourglass-split me-1"></i>Pending</p>
            </div>
        </div>
    </div>
</div>

@* Quick Links *@
<div class="row g-3">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-person-badge display-4 text-primary"></i>
                <h5 class="mt-2">Doctor Management</h5>
                <p class="text-muted small">View, add, edit and deactivate doctors</p>
                <a asp-action="Doctors" class="btn btn-primary btn-sm">Manage Doctors</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-calendar-week display-4 text-success"></i>
                <h5 class="mt-2">Schedule Management</h5>
                <p class="text-muted small">Configure doctor availability and schedules</p>
                <a asp-action="Schedules" class="btn btn-success btn-sm">Manage Schedules</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-people display-4 text-info"></i>
                <h5 class="mt-2">User Management</h5>
                <p class="text-muted small">View all users and manage role assignments</p>
                <a asp-action="Users" class="btn btn-info btn-sm text-white">Manage Users</a>
            </div>
        </div>
    </div>
</div>