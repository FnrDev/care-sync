@{
    ViewData["Title"] = "Home";
}

<!-- ── Hero ─────────────────────────────────────────── -->
<section class="cs-hero">
    <div class="cs-hero-inner">
        <div class="cs-hero-content">
            <span class="cs-hero-badge">
                <i class="bi bi-heart-pulse"></i> Trusted Healthcare Platform
            </span>
            <h1 class="cs-hero-title">Your Health,<br>Our Priority</h1>
            <p class="cs-hero-sub">
                Comprehensive appointment management for patients and healthcare professionals.
                Book, track, and manage your medical care with ease.
            </p>
            <div class="cs-hero-btns">
                <a asp-controller="Booking" asp-action="Index" class="cs-btn-solid">
                    <i class="bi bi-calendar-plus"></i> Book Appointment
                </a>
                <a asp-controller="Tracking" asp-action="Index" class="cs-btn-outline">
                    <i class="bi bi-search"></i> Track Appointment
                </a>
            </div>
        </div>

        <div class="cs-hero-stats">
            <div class="cs-stat">
                <div class="cs-stat-icon"><i class="bi bi-person-check-fill"></i></div>
                <div class="cs-stat-body">
                    <span class="cs-stat-num">500+</span>
                    <span class="cs-stat-lbl">Expert Doctors</span>
                </div>
            </div>
            <div class="cs-stat">
                <div class="cs-stat-icon"><i class="bi bi-people-fill"></i></div>
                <div class="cs-stat-body">
                    <span class="cs-stat-num">10,000+</span>
                    <span class="cs-stat-lbl">Patients Served</span>
                </div>
            </div>
            <div class="cs-stat">
                <div class="cs-stat-icon"><i class="bi bi-star-fill"></i></div>
                <div class="cs-stat-body">
                    <span class="cs-stat-num">98%</span>
                    <span class="cs-stat-lbl">Satisfaction Rate</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ── Quick Actions (authenticated users only) ──────── -->
@if (ViewBag.IsAuthenticated == true)
{
    <div class="container mt-5 mb-4">
        <p class="text-uppercase fw-bold mb-3" style="font-size:.75rem;letter-spacing:.1em;color:var(--muted);">
            Quick Actions
        </p>
        <div class="row g-3">
            @if (ViewBag.UserRole == "Patient")
            {
                <div class="col-md-4">
                    <a asp-controller="Booking" asp-action="Index" class="cs-action-card">
                        <div class="cs-action-icon"><i class="bi bi-calendar-plus"></i></div>
                        <div>
                            <div class="cs-action-title">Book Appointment</div>
                            <div class="cs-action-sub">Schedule with your preferred doctor</div>
                        </div>
                        <i class="bi bi-arrow-right ms-auto"></i>
                    </a>
                </div>
                <div class="col-md-4">
                    <a asp-controller="Patient" asp-action="Dashboard" class="cs-action-card">
                        <div class="cs-action-icon"><i class="bi bi-speedometer2"></i></div>
                        <div>
                            <div class="cs-action-title">My Dashboard</div>
                            <div class="cs-action-sub">View appointments and history</div>
                        </div>
                        <i class="bi bi-arrow-right ms-auto"></i>
                    </a>
                </div>
                <div class="col-md-4">
                    <a asp-controller="Patient" asp-action="MedicalRecords" class="cs-action-card">
                        <div class="cs-action-icon"><i class="bi bi-journal-medical"></i></div>
                        <div>
                            <div class="cs-action-title">Medical Records</div>
                            <div class="cs-action-sub">Access your visit history</div>
                        </div>
                        <i class="bi bi-arrow-right ms-auto"></i>
                    </a>
                </div>
            }
            @if (ViewBag.UserRole == "Receptionist")
            {
                <div class="col-md-6">
                    <a asp-controller="Receptionist" asp-action="Dashboard" class="cs-action-card">
                        <div class="cs-action-icon"><i class="bi bi-speedometer2"></i></div>
                        <div>
                            <div class="cs-action-title">Receptionist Dashboard</div>
                            <div class="cs-action-sub">Manage appointments and queue</div>
                        </div>
                        <i class="bi bi-arrow-right ms-auto"></i>
                    </a>
                </div>
                <div class="col-md-6">
                    <a asp-controller="Receptionist" asp-action="BookForPatient" class="cs-action-card">
                        <div class="cs-action-icon"><i class="bi bi-calendar-plus"></i></div>
                        <div>
                            <div class="cs-action-title">Book for Patient</div>
                            <div class="cs-action-sub">Schedule appointments for patients</div>
                        </div>
                        <i class="bi bi-arrow-right ms-auto"></i>
                    </a>
                </div>
            }
        </div>
    </div>
}
