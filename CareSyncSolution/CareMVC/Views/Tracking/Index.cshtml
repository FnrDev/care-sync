@model TrackingViewModel
@{
    ViewData["Title"] = "Track Appointment";
}

<!-- ── Page Header ───────────────────────────────────── -->
<div class="cs-page-header">
    <div class="container">
        <h2 class="cs-page-header-title"><i class="bi bi-search me-2"></i>Track Your Appointment</h2>
        <p class="cs-page-header-sub">Enter your CPR number to view your appointment status in real time.</p>
    </div>
</div>

<!-- ── Search & Results ──────────────────────────────── -->
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <!-- Search Form -->
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Index" method="post">
                        <div class="row g-3 mb-3">
                            <div class="col-md-5">
                                <label class="form-label">CPR Number</label>
                                <input asp-for="CPR" class="form-control" placeholder="e.g. 041203780" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Reference Number <span class="text-muted fw-normal text-lowercase">(optional)</span></label>
                                <input asp-for="RefNumber" class="form-control" placeholder="e.g. PAT-0001" />
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-search me-1"></i>Search
                                </button>
                            </div>
                        </div>
                    </form>

                    @if (Model.ErrorMessage != null)
                    {
                        <div class="alert alert-warning mt-2">
                            <i class="bi bi-exclamation-triangle me-1"></i> @Model.ErrorMessage
                        </div>
                    }
                </div>
            </div>

            @if (Model.Result != null)
            {
                <!-- Patient Info -->
                <div class="card shadow-sm mt-4">
                    <div class="card-header">
                        <i class="bi bi-person me-2"></i>Patient Information
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-6">
                                <p class="mb-1"><span class="text-muted" style="font-size:.8rem;text-transform:uppercase;letter-spacing:.05em;">CPR</span></p>
                                <p class="fw-600 mb-0">@Model.Result.Patient.CPR</p>
                            </div>
                            <div class="col-sm-6">
                                <p class="mb-1"><span class="text-muted" style="font-size:.8rem;text-transform:uppercase;letter-spacing:.05em;">Reference Number</span></p>
                                <p class="fw-600 mb-0">@Model.Result.Patient.PatientRefNumber</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Upcoming Appointments -->
                <div class="card shadow-sm mt-3">
                    <div class="card-header">
                        <i class="bi bi-calendar-check me-2"></i>Upcoming Appointments
                    </div>
                    <div class="card-body">
                        @if (Model.Result.UpcomingAppointments.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Time</th>
                                            <th>Doctor</th>
                                            <th>Specialization</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var apt in Model.Result.UpcomingAppointments)
                                        {
                                            <tr>
                                                <td>@apt.AppointmentDate.ToString("dd MMM yyyy")</td>
                                                <td>@apt.StartTime – @apt.EndTime</td>
                                                <td>@apt.Doctor</td>
                                                <td>@apt.Specialization</td>
                                                <td><partial name="_StatusBadge" model="@apt.Status" /></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0"><i class="bi bi-calendar-x me-1"></i>No upcoming appointments found.</p>
                        }
                    </div>
                </div>

                <!-- Recent Visits -->
                <div class="card shadow-sm mt-3">
                    <div class="card-header">
                        <i class="bi bi-clock-history me-2"></i>Recent Visits
                    </div>
                    <div class="card-body">
                        @if (Model.Result.RecentVisits.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Doctor</th>
                                            <th>Diagnosis</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var visit in Model.Result.RecentVisits)
                                        {
                                            <tr>
                                                <td>@visit.CreatedAt.ToString("dd MMM yyyy")</td>
                                                <td>@visit.Doctor</td>
                                                <td>@visit.Diagnosis</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No recent visits found.</p>
                        }
                    </div>
                </div>
            }

        </div>
    </div>
</div>
