@model CareMVC.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="cs-login-wrap">
    <div class="cs-login-card">

        <!-- Logo -->
        <div class="cs-login-logo">
            <i class="bi bi-heart-pulse"></i>
        </div>

        <h2 class="cs-login-title">Welcome Back</h2>
        <p class="cs-login-sub">Sign in to your CareSync account</p>

        <div asp-validation-summary="All" class="alert alert-danger text-start py-2 small mb-3" style="display:none;"></div>

        <form asp-action="Login" method="post" id="loginForm">
            <div class="cs-form-group">
                <label asp-for="Email" class="cs-label">Email Address</label>
                <input asp-for="Email" class="cs-input" type="email" placeholder="your@email.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
            </div>

            <div class="cs-form-group">
                <label asp-for="Password" class="cs-label">Password</label>
                <input asp-for="Password" class="cs-input" type="password" placeholder="Enter your password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
            </div>

            <button type="submit" class="cs-login-btn mt-2">
                <i class="bi bi-box-arrow-in-right"></i> Sign In
            </button>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show validation summary only when there are real errors
        var vs = document.querySelector('[data-valmsg-summary]');
        if (vs && vs.classList.contains('validation-summary-errors')) vs.style.display = 'block';
    </script>
}
